{
    "name": "atom-power-mode",
    "displayName": "Atom Power Mode (Canvas)",
    "description": "%extension.description%",
    "version": "1.1.1",
    "publisher": "pks424",
    "license": "MIT",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/pks424/atom-power-mode.git"
    },
    "bugs": {
        "url": "https://github.com/pks424/atom-power-mode/issues"
    },
    "homepage": "https://github.com/pks424/atom-power-mode#readme",
    "keywords": [
        "power mode",
        "activate-power-mode",
        "atom",
        "particles",
        "combo",
        "screen shake",
        "typing effect"
    ],
    "galleryBanner": {
        "color": "#1b1d23",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "scripts": {
        "vscode:uninstall": "node ./uninstall.js"
    },
    "contributes": {
        "commands": [
            {
                "command": "atomPowerMode.enable",
                "title": "%command.enable%"
            },
            {
                "command": "atomPowerMode.disable",
                "title": "%command.disable%"
            },
            {
                "command": "atomPowerMode.reapply",
                "title": "%command.reapply%"
            }
        ],
        "configuration": {
            "title": "Atom Power Mode",
            "properties": {
                "atomPowerMode.enabled": {
                    "type": "boolean",
                    "default": true,
                    "order": 0,
                    "description": "%config.enabled%"
                },
                "atomPowerMode.particleCount": {
                    "type": "number",
                    "default": 12,
                    "minimum": 1,
                    "maximum": 60,
                    "order": 1,
                    "description": "%config.particleCount%"
                },
                "atomPowerMode.particleSize": {
                    "type": "number",
                    "default": 3.5,
                    "minimum": 1,
                    "maximum": 12,
                    "order": 2,
                    "description": "%config.particleSize%"
                },
                "atomPowerMode.gravity": {
                    "type": "number",
                    "default": 0.12,
                    "minimum": 0,
                    "maximum": 1,
                    "order": 3,
                    "description": "%config.gravity%"
                },
                "atomPowerMode.maxParticles": {
                    "type": "number",
                    "default": 500,
                    "minimum": 50,
                    "maximum": 3000,
                    "order": 4,
                    "description": "%config.maxParticles%"
                },
                "atomPowerMode.shake.enabled": {
                    "type": "boolean",
                    "default": true,
                    "order": 5,
                    "description": "%config.shake.enabled%"
                },
                "atomPowerMode.shake.intensity": {
                    "type": "number",
                    "default": 3,
                    "minimum": 0,
                    "maximum": 20,
                    "order": 6,
                    "description": "%config.shake.intensity%"
                },
                "atomPowerMode.shake.duration": {
                    "type": "number",
                    "default": 90,
                    "minimum": 0,
                    "maximum": 1000,
                    "order": 7,
                    "description": "%config.shake.duration%"
                },
                "atomPowerMode.combo.enabled": {
                    "type": "boolean",
                    "default": true,
                    "order": 8,
                    "description": "%config.combo.enabled%"
                },
                "atomPowerMode.combo.timeout": {
                    "type": "number",
                    "default": 10,
                    "minimum": 0,
                    "maximum": 120,
                    "order": 9,
                    "description": "%config.combo.timeout%"
                },
                "atomPowerMode.combo.activationThreshold": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 1000,
                    "order": 10,
                    "description": "%config.combo.activationThreshold%"
                },
                "atomPowerMode.combo.exclamations": {
                    "type": "boolean",
                    "default": true,
                    "order": 11,
                    "description": "%config.combo.exclamations%"
                }
            }
        }
    }
}
